{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notepaper",
  "version": "0.1.0",
  "identifier": "com.notepaper.sticky",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "小便签",
        "width": 380,
        "height": 620,
        "minWidth": 320,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
